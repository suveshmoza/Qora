DATABASE_URL=postgresql://analyst_agent:analyst_pw@localhost:5432/prod
NODE_ENV=development
# stdio = Cursor/Claude Desktop; http = Streamable HTTP (ngrok/remote)
TRANSPORT=http
HOST=127.0.0.1
PORT=8080
# * = open (development/ngrok only); production HTTP requires an explicit allowlist
ALLOWED_HOSTS=*
LOG_LEVEL=info
# optional override for development/test (default: pretty on). Ignored in production.
# LOG_PRETTY=false
