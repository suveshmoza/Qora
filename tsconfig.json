{
  "compilerOptions": {
    "target": "es2022",
    "module": "NodeNext",
    "rootDir": "src",
    "moduleResolution": "NodeNext",

    "outDir": "dist",
    "esModuleInterop": true,

    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noImplicitAny": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "types": ["node", "vitest/globals"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}
